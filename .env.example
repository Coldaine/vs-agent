# Copy to .env and fill in. All endpoints are OpenAI-compatible.
# Values are read by spine/model_client.py (never hardcoded).

# Fast VLM — movement proposals (one token per call)
FOLLOWER_URL=http://localhost:8000/v1
FOLLOWER_KEY=not-needed
FOLLOWER_MODEL=Qwen3-VL-4B

# Mid-tier — level-up picks + strategy briefs
LEADER_URL=https://api.example.com/v1
LEADER_KEY=sk-...
LEADER_MODEL=gpt-5.6-luna

# Optional — review/theorist/labeler sub-agents. Falls back to LEADER_* if unset.
# REVIEWER_URL=
# REVIEWER_KEY=
# REVIEWER_MODEL=
